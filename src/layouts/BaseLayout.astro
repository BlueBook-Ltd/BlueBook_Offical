---
// BaseLayout.astro — shared shell for all Bluebook pages
// Props: title, description?, lang ('zh-Hant' | 'en')
import '../styles/global.css';
import '../styles/fonts.css';

const { title, description, lang = 'zh-Hant' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {description && <meta name="description" content={description} />}
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>