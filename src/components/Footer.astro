---
// Bluebook Footer — shared component
// Props: lang ('zh' | 'en'), hideCta (boolean, optional)
const { lang = 'zh', hideCta = false } = Astro.props;
const isZh = lang === 'zh';
---

<style is:global>
  /* -- CTA Section (inside footer) -- */
  .cta-section {
    width: 100%;
    padding: 112px 0;
    background: linear-gradient(150deg, #070e1f 0%, #0b1630 100%);
    position: relative;
    overflow: hidden;
    text-align: center;
    color: #fff;
  }
  .cta-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(37,99,235,0.16), transparent 65%);
    pointer-events: none;
  }
  .cta-shimmer {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 66%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(37,99,235,0.5), transparent);
  }
  .cta-inner {
    width: min(100% - 48px, 720px);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .cta-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    color: #60a5fa;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .cta-kicker .line {
    width: 16px;
    height: 1px;
    background: #60a5fa;
    flex-shrink: 0;
  }
  .cta-section h2 {
    font-size: clamp(34px, 3.5vw, 48px);
    font-weight: 560;
    line-height: 1.06;
    letter-spacing: -0.045em;
    margin-bottom: 20px;
    white-space: normal;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .cta-section p {
    font-size: 17px;
    color: #94a3b8;
    line-height: 1.8;
    margin-bottom: 40px;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .html, body {
    overflow-x: hidden;
  }
  @media (max-width: 768px) {
    .cta-section { padding: 80px 0; }
  }

  /* -- Footer -- */
  .footer {
    background: #050d1a;
    padding: 72px 0 28px;
    color: #fff;
  }
  .footer-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .footer-brand { max-width: 520px; }
  .footer-logo-text {
    font-size: 26px;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .footer-brand-desc {
    font-size: 15px;
    line-height: 1.8;
    color: #94a3b8;
    margin-bottom: 14px;
  }
  .footer-contact { max-width: 380px; }
  .footer-contact-title {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 14px;
  }
  .footer-contact-desc {
    font-size: 15px;
    line-height: 1.7;
    color: #94a3b8;
    margin-bottom: 12px;
  }
  .footer-email {
    display: inline-block;
    font-size: 15px;
    color: #60a5fa;
    text-decoration: none;
    margin-bottom: 18px;
  }
  .footer-email:hover { color: #93c5fd; }

  .footer-bottom {
    max-width: 1160px;
    margin: 60px auto 0;
    padding: 22px 32px 0;
    border-top: 1px solid rgba(148,163,184,0.20);
    text-align: left;
    font-size: 13px;
    color: #64748b;
  }

  @media (min-width: 768px) {
    .footer-inner { flex-direction: row; justify-content: space-between; gap: 80px; }
  }
</style>

{!hideCta && (
<!-- CTA Section -->
<section class="cta-section">
  <div class="cta-shimmer" aria-hidden="true"></div>
  <div class="cta-inner">
    <p class="cta-kicker">
      <span class="line"></span>{isZh ? '開始討論' : 'Start the Conversation'}
    </p>
    <h2>{isZh ? '準備好了解你的流程可以怎樣改善？' : 'Ready to see how your workflows can improve?'}</h2>
    <p>{isZh ? '不需要技術文件，只要有想改善的流程就可以開始討論。' : 'No technical document needed — just describe your workflow and pain points.'}</p>
    <a href={isZh ? '/zh/contact/' : '/en/contact/'} class="btn btn-primary">{isZh ? '聯絡 Bluebook' : 'Contact Bluebook'}</a>
  </div>
</section>
)}

<!-- Footer -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-logo-text">BLUEBOOK</div>
      <p class="footer-brand-desc">{isZh ? 'Bluebook 協助企業由真實業務流程出發，導入 AI、自動化及系統整合方案，將重複、耗時、容易出錯的工作轉化為更高效、可追蹤的營運流程。' : 'Bluebook helps companies start from real business workflows, introducing AI, automation, and system integration solutions to turn repetitive, time-consuming, and error-prone tasks into more efficient and traceable operations.'}</p>
    </div>

    <div class="footer-contact">
      <div class="footer-contact-title">{isZh ? '聯絡我們' : 'Contact Us'}</div>
      <p class="footer-contact-desc">{isZh ? '由一個重複、耗時或容易出錯的流程開始，探索 AI 自動化的可行性。' : 'Start with one repetitive, time-consuming or error-prone process and explore the feasibility of AI automation.'}</p>
      <a href="mailto:bluebybook@outlook.com" class="footer-email">bluebybook@outlook.com</a>
      <br>
      <a href={isZh ? '/zh/contact/' : '/en/contact/'} class="btn btn-primary">{isZh ? '聯絡 Bluebook' : 'Contact Bluebook'}</a>
    </div>
  </div>

  <div class="footer-bottom">
    &copy; 2026 Bluebook. All rights reserved.
  </div>
</footer>