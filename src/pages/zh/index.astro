---
// Bluebook Homepage — ZH
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const lang = 'zh-Hant';
const currentPath = '/zh/';
const title = 'Bluebook — AI Automation · Workflow Design · System Integration';
---

<BaseLayout title={title} lang={lang}>
  <Header lang="zh" heroPage={true} currentPath={currentPath} />

  <style>
    /* ── Page-specific CSS (Hero, What We Do, Bento, Process, CTA) ── */

    /* Hero */
    .hero {
      min-height: 50vh;
      display: grid;
      place-items: center;
      padding: 120px 0 96px;
      background: linear-gradient(150deg, #070e1f 0%, #0b1630 60%, #070e1f 100%);
      color: #fff;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 1000px;
      height: 700px;
      background: radial-gradient(ellipse at 50% 30%, rgba(37,99,235,0.18), transparent 65%);
      pointer-events: none;
    }
    .hero-grid-lines {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .hero-grid-lines .line {
      position: absolute;
      top: 0;
      width: 1px;
      height: 100%;
      background: rgba(255,255,255,0.02);
    }
    .hero-grid-lines .line:nth-child(1) { left: 33%; }
    .hero-grid-lines .line:nth-child(2) { right: 33%; }
    .hero-inner {
      width: min(100% - 48px, var(--container));
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* Typography — ZH: titleLines, keep-all, no broken words */
    .hero h1 {
      max-width: 720px;
      font-size: clamp(36px, 4.2vw, 58px);
      font-weight: 700;
      line-height: 1.12;
      letter-spacing: 0em;
      margin-bottom: 24px;
      word-break: keep-all;
      overflow-wrap: normal;
    }
    .hero-title-line {
      display: block;
    }
    .hero p {
      max-width: 660px;
      font-size: clamp(16px, 1.45vw, 20px);
      color: #94a3b8;
      line-height: 1.9;
      margin-bottom: 40px;
      word-break: keep-all;
      overflow-wrap: break-word;
    }
    .hero-content {
      max-width: 720px;
      margin: 0 auto;
    }
    .hero .cta-group { justify-content: flex-start; }

    /* What We Do */
    .what-we-do {
      border-top: 1px solid #f1f5f9;
      background: #fff;
    }
    .what-we-do .section-header { max-width: 760px; }

    /* Services Bento */
    .services-section {
      border-top: 1px solid #f1f5f9;
      background: #f0f5ff;
    }
    .services-section .section-header { margin-bottom: 48px; }
    .services-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .service-card {
      background: #fff;
      border: 1px solid #f1f5f9;
      border-radius: 16px;
      padding: 28px;
      position: relative;
      overflow: hidden;
      transition: all 0.2s ease;
      min-height: 220px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .service-card:hover {
      border-color: #bfdbfe;
      box-shadow: 0 12px 40px rgba(37,99,235,0.06);
      transform: translateY(-2px);
    }
    .service-card.glow::before {
      content: "";
      position: absolute;
      top: -40px;
      right: -40px;
      width: 144px;
      height: 144px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37,99,235,0.07), transparent 70%);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }
    .service-card:hover.glow::before { opacity: 1; }
    .service-card h3 {
      font-size: 20px;
      font-weight: 560;
      color: var(--ink);
      margin-bottom: 12px;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .service-card p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.8;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    .service-card-link {
      position: absolute;
      inset: 0;
      border-radius: 16px;
    }

    /* Section headers for ZH — no negative letter-spacing on titles */
    .section-title {
      letter-spacing: 0em;
    }

    /* How We Work */
    .process-section {
      border-top: 1px solid #f1f5f9;
      background: #fff;
    }
    .process-section .section-header { margin-bottom: 48px; }
    .step-list { display: flex; flex-direction: column; gap: 4px; }
    .step-item {
      display: flex;
      gap: 32px;
      padding: 32px;
      border-radius: 16px;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }
    .step-item:hover {
      border-color: #f1f5f9;
      background: #f8fafc;
    }
    .step-num {
      flex-shrink: 0;
      font-family: 'DM Mono', monospace;
      font-size: 48px;
      font-weight: 700;
      color: #f1f5f9;
      line-height: 1;
      padding-top: 4px;
      user-select: none;
      transition: color 0.2s ease;
    }
    .step-item:hover .step-num { color: #dbeafe; }
    .step-item h3 {
      font-size: 20px;
      font-weight: 560;
      color: var(--ink);
      margin-bottom: 12px;
    }
    .step-item p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.8;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    @media (min-width: 768px) {
      .services-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .services-grid { grid-template-columns: repeat(3, 1fr); }
      .hero { min-height: 50vh; padding: 140px 0 120px; }
    }
    @media (max-width: 768px) {
      .section { padding: 60px 0; }
      .hero { padding: 96px 0 72px; }
      .hero h1 {
        max-width: 100%;
        font-size: clamp(34px, 9vw, 46px);
        line-height: 1.12;
      }
      .section-title, section h2 {
        max-width: 100%;
        font-size: clamp(28px, 7vw, 38px);
        line-height: 1.18;
      }
      .services-section { padding: 60px 0; }
      .process-section { padding: 60px 0; }
      .service-card h3 { font-size: 20px; }
    }
  </style>

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-grid-lines" aria-hidden="true">
      <div class="line"></div>
      <div class="line"></div>
    </div>
    <div class="hero-inner">
      <h1>
          <span class="hero-title-line">從真實業務流程開始，</span>
          <span class="hero-title-line">導入可落地的 AI 自動化</span>
        </h1>
      <p>Bluebook 協助企業分析現有工作流程，找出重複、耗時、容易出錯的任務，設計 AI、自動化及系統整合方案，將日常工作轉化為更高效、可追蹤、可擴展的營運流程。</p>
      <div class="cta-group">
        <a href="/zh/services/" class="btn btn-primary">查看服務</a>
        <a href="/zh/contact/" class="btn btn-primary">聯絡我們</a>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT WE DO ═══ -->
  <section class="section what-we-do">
    <div class="container">
      <div class="section-header">
        <div class="section-kicker">我們的定位</div>
        <h2 class="section-title">讓 AI 工具真正融入日常營運</h2>
        <p class="section-subtitle">我們不只是介紹 AI 工具，而是由實際業務流程出發，判斷哪些步驟適合自動化、哪些資料需要結構化、哪些系統需要整合，讓 AI 成為團隊真正用得上的營運能力。</p>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES BENTO ═══ -->
  <section id="services" class="section services-section">
    <div class="container">
      <div class="section-header">
        <div class="section-kicker">服務範圍</div>
        <h2 class="section-title">由流程分析到系統落地，建立更智能的工作方式</h2>
        <p class="section-subtitle">由 AI 顧問、自動化流程設計，到 OCR 文件處理、系統整合及內部工具開發，Bluebook 協助企業逐步建立更高效、更可追蹤的營運流程。</p>
      </div>

      <div class="services-grid">
        <article class="service-card glow">
          <h3>WhatsApp AI Agent</h3>
          <p>將 WhatsApp 群組中的日常對話、語音、圖片及文件整理成可搜尋、可追蹤、可匯出的專案紀錄。</p>
          <a href="/zh/services/whatsapp-ai-agent/" class="service-card-link" aria-label="了解 WhatsApp AI Agent"></a>
        </article>
        <article class="service-card glow">
          <h3>AI OCR 與資料抽取</h3>
          <p>從 PDF、掃描件、圖片及業務文件中抽取指定欄位，轉化為可搜尋、可核對、可匯出的結構化數據。</p>
          <a href="/zh/services/ai-ocr/" class="service-card-link" aria-label="了解 AI OCR 與資料抽取"></a>
        </article>
        <article class="service-card glow">
          <h3>AI 工作流程自動化</h3>
          <p>將重複、耗時、依賴人手的流程轉化為自動化工作流，例如資料輸入、審批、通知及報表生成。</p>
        </article>
        <article class="service-card glow">
          <h3>AI 與 IT 顧問</h3>
          <p>協助企業評估現有系統、流程及技術需要，制定適合業務階段的 AI 導入與數碼轉型方向。</p>
        </article>
        <article class="service-card glow">
          <h3>系統整合</h3>
          <p>將 AI、自動化工具及內部系統連接起來，包括 CRM、ERP、Google Workspace、Microsoft 365、API 及資料庫。</p>
        </article>
        <article class="service-card glow">
          <h3>資料處理與報表生成</h3>
          <p>自動整理來自文件、表格、系統及 API 的資料，生成可用於營運分析、管理匯報及決策支援的數據。</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ HOW WE WORK ═══ -->
  <section id="process" class="section process-section">
    <div class="container">
      <div class="section-header">
        <div class="section-kicker">導入方式</div>
        <h2 class="section-title">從流程分析開始，而不是從工具開始</h2>
      </div>
      <div class="step-list">
        <div class="step-item">
          <span class="step-num">01</span>
          <div>
            <h3>理解現有流程</h3>
            <p>了解現有工作流程、資料來源、系統限制及團隊日常痛點。</p>
          </div>
        </div>
        <div class="step-item">
          <span class="step-num">02</span>
          <div>
            <h3>設計自動化方案</h3>
            <p>設計合適的 AI、自動化、系統整合或內部工具方案，先由高價值場景開始。</p>
          </div>
        </div>
        <div class="step-item">
          <span class="step-num">03</span>
          <div>
            <h3>落地測試及持續優化</h3>
            <p>協助團隊實際使用，收集 feedback，並按使用情況持續優化流程及系統設定。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang="zh" />
</BaseLayout>