<script>
  // @ts-nocheck
  const workflowVideo = document.getElementById("workflowVideo");

  function keepVideoLooping() {
    if (!workflowVideo) return;

    workflowVideo.muted = true;
    workflowVideo.loop = true;
    workflowVideo.playsInline = true;

    const playPromise = workflowVideo.play();
    if (playPromise !== undefined) {
      playPromise.catch(() => {
        workflowVideo.muted = true;
      });
    }
  }

  window.addEventListener("load", keepVideoLooping);

  if (workflowVideo) {
    workflowVideo.addEventListener("ended", () => {
      workflowVideo.currentTime = 0;
      workflowVideo.play();
    });

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) keepVideoLooping();
    });
  }
</script>

<script>
  // @ts-nocheck
  const cases = {
    finance: {
      title: "財務",
      desc: "財務團隊可從銀行文件、財務報表、付款紀錄及申請表中抽取申請人資料、資產、負債、收入、支出及其他關鍵欄位。",
      blocks: [
        { label: "財務報表" },
        { label: "銀行月結單" },
        { label: "收入紀錄" },
        { label: "資產紀錄" }
      ],
      bg: "finance-bg",
      doc: "doc-finance"
    },
    insurance: {
      title: "保險",
      desc: "保險團隊可處理保險證書、保單表格、索償紀錄及保障文件，抽取受保人資料、保單日期、保障範圍及重要參考資訊。",
      blocks: [
        { label: "責任保險證書" },
        { label: "保單表格" },
        { label: "索償紀錄" },
        { label: "保障證明" }
      ],
      bg: "insurance-bg",
      doc: "doc-insurance"
    },
    logistics: {
      title: "物流",
      desc: "物流團隊可從裝箱單及運輸文件中抽取發貨人、收貨人、發票編號、提單號碼、SKU、貨品數量、尺寸、重量及申報價值。",
      blocks: [
        { label: "裝箱單" },
        { label: "送貨單" },
        { label: "提單" },
        { label: "運輸發票" }
      ],
      bg: "logistics-bg",
      doc: "doc-logistics"
    },
    legal: {
      title: "法務",
      desc: "法務團隊可從合約、協議書、證書及法律文件中抽取標題、作者、日期、當事方、條款、引用、參考文獻及關鍵術語。",
      blocks: [
        { label: "法律文件" },
        { label: "合約" },
        { label: "協議書" },
        { label: "研究論文" }
      ],
      bg: "legal-bg",
      doc: "doc-legal"
    }
  };

  const tabs = document.querySelectorAll(".tab[data-tab]");
  const title = document.getElementById("case-title");
  const desc = document.getElementById("case-desc");
  const blockGrid = document.getElementById("document-block-grid");
  const visual = document.getElementById("visual");
  const docViews = document.querySelectorAll(".doc-view");

  function renderBlocks(blocks) {
    // Update existing DOM elements instead of innerHTML to preserve Astro scoped styles
    const items = blockGrid.querySelectorAll(".document-block strong");
    for (let i = 0; i < blocks.length && i < items.length; i++) {
      items[i].textContent = blocks[i].label;
    }
  }

  function activateCase(key) {
    const data = cases[key];
    title.textContent = data.title;
    desc.textContent = data.desc;
    renderBlocks(data.blocks);
    visual.className = "visual";
    visual.classList.add(data.bg);
    docViews.forEach((view) => view.classList.remove("active"));
    document.getElementById(data.doc).classList.add("active");
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((item) => item.classList.remove("active"));
      tab.classList.add("active");
      activateCase(tab.dataset.tab);
    });
  });
</script>

