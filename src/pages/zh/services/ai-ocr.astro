---
// AI OCR Service Page
// Bluebook Official Website
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
const currentPath = "/zh/services/ai-ocr/";
---

<BaseLayout title="AI OCR & Data Extraction | Bluebook" lang="zh-Hant">
  <Header lang="zh" heroPage={true} currentPath={currentPath} />

<style>
  .page {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: hidden;
    background: #fff;
  }

  .page::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -5;
    pointer-events: none;
    background:
      radial-gradient(circle at 8% 4%, rgba(30, 98, 190, 0.55), transparent 10%),
      radial-gradient(circle at 70% 4%, rgba(33, 214, 255, 0.12), transparent 10%),
      linear-gradient(180deg, #071525 0%, #071525 5%, #ffffff 30%, #ffffff 100%);
  }

  .page::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -4;
    pointer-events: none;
    background:
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    opacity: 0.42;
    mask-image: linear-gradient(180deg, black 0%, black 42%, rgba(0,0,0,0.28) 56%, transparent 78%);
  }

  .hero {
    min-height: 560px;
    display: grid;
    place-items: center;
    padding: 86px 0 76px;
    text-align: center;
    color: #fff;
  }

  .hero-content {
    max-width: 1080px;
  }

  .hero h1 {
    margin-bottom: 26px;
    font-size: clamp(44px, 6vw, 76px);
    line-height: 1;
    font-weight: 780;
    letter-spacing: -0.055em;
    text-shadow: 0 20px 60px rgba(0, 0, 0, 0.38);
  }

  .hero p {
    max-width: 980px;
    margin: 0 auto 34px;
    color: rgba(230, 240, 255, 0.8);
    font-size: clamp(16px, 1.45vw, 20px);
    line-height: 1.9;
    font-weight: 560;
  }

  .section-compact {
    padding: 80px 0;
  }

  .section-problem {
    padding: 80px 0;
    color: #f7f9ff;
  }
  .section-problem .section-title,
  .section-problem .section-subtitle {
    color: #fff;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 18px;
  }

  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .glass-card {
    border: 1px solid rgba(20, 32, 51, 0.1);
    border-radius: 26px;
    background: rgba(255,255,255,0.82);
    box-shadow: var(--shadow-light);
    padding: 28px;
    backdrop-filter: blur(14px);
  }

  .section-problem .glass-card {
    min-height: 230px;
    color: #fff;
    border: 1px solid rgba(255,255,255,0.14);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.11), rgba(255,255,255,0.045)),
      rgba(255,255,255,0.035);
    box-shadow: var(--shadow-dark);
  }

  .card-icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    margin-bottom: 20px;
    border-radius: 18px;
    color: #fff;
    background:
      radial-gradient(circle at 28% 22%, rgba(255,255,255,0.45), transparent 24%),
      linear-gradient(135deg, var(--cyan), var(--purple));
    font-size: 18px;
    font-weight: 780;
    box-shadow: 0 0 38px rgba(33,214,255,0.22);
  }

  .glass-card h3,
  .feature h3,
  .usecase-card h3 {
    margin-bottom: 10px;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .glass-card p,
  .feature p {
    color: currentColor;
    opacity: 0.72;
    font-size: 14px;
    line-height: 1.78;
  }

  .features-intro {
    max-width: 980px;
    margin-bottom: 58px;
  }

  .features-intro .section-kicker {
    justify-content: flex-start;
  }

  .features-intro .section-title,
  .features-intro .section-subtitle {
    text-align: left;
    margin-left: 0;
    color: #fff;
  }

  .features-intro .section-title {
    max-width: 850px;
  }

  .features-intro .section-subtitle {
    max-width: 760px;
    margin-bottom: 0;
  }

  .feature-icon-circle {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    margin-bottom: 18px;
    border: 2px solid var(--feature-color);
    border-radius: 999px;
    color: #101827;
    background: rgba(255,255,255,0.68);
    box-shadow: 0 0 28px rgba(40, 62, 100, 0.12);
  }

  .feature-cyan { --feature-color: #43d9ff; }
  .feature-pink { --feature-color: #f041b0; }
  .feature-orange { --feature-color: #f5a524; }

  .screenshot-mockup {
    max-width: 1120px;
    margin: 76px auto 0;
    padding: 12px;
    border: 1px solid rgba(20,32,51,0.1);
    border-radius: 28px;
    background:
      radial-gradient(circle at 18% 0%, rgba(33,214,255,0.12), transparent 32%),
      radial-gradient(circle at 86% 0%, rgba(124,92,255,0.12), transparent 30%),
      rgba(255,255,255,0.88);
    box-shadow: 0 34px 90px rgba(40,62,100,0.16), 0 0 0 1px rgba(255,255,255,0.7) inset;
    overflow: hidden;
  }

  .screenshot-frame {
    overflow: hidden;
    border-radius: 20px;
    background: #f8fafc;
  }

  .screenshot-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .function-layout-section {
    padding-top: 96px;
  }

  .function-layout {
    margin-top: 28px;
  }

  .function-row {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: 72px;
    align-items: center;
    margin-bottom: 72px;
  }

  .function-row:last-child {
    margin-bottom: 0;
  }

  .function-copy h3 {
    max-width: 450px;
    margin-bottom: 18px;
    color: #101827;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.05;
    font-weight: 780;
    letter-spacing: -0.055em;
  }

  .function-copy p {
    max-width: 450px;
    color: #53617a;
    font-size: 14px;
    line-height: 1.85;
    font-weight: 560;
  }

  .function-visual {
    min-height: 205px;
    display: grid;
    place-items: center;
    border: 1px dashed rgba(20,32,51,0.18);
    border-radius: 20px;
    background:
      radial-gradient(circle at 50% 18%, rgba(33,214,255,0.14), transparent 36%),
      linear-gradient(135deg, rgba(255,255,255,0.9), rgba(246,249,255,0.8));
    box-shadow: 0 18px 54px rgba(40,62,100,0.06);
  }

  .function-visual-content {
    text-align: center;
    padding: 24px;
  }

  .function-visual-icon {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    margin: 0 auto 14px;
    border-radius: 999px;
    color: #fff;
    background:
      radial-gradient(circle at 28% 22%, rgba(255,255,255,0.45), transparent 24%),
      linear-gradient(135deg, var(--cyan), var(--purple));
    font-size: 24px;
    font-weight: 800;
    box-shadow: 0 18px 60px rgba(33,214,255,0.2);
  }

  .function-visual small {
    color: #667085;
    font-size: 12px;
    font-weight: 650;
  }

  .image-slot {
    min-height: 250px;
    display: grid;
    place-items: center;
    border: 1px dashed rgba(20,32,51,0.18);
    border-radius: 20px;
    background:
      radial-gradient(circle at 50% 18%, rgba(33,214,255,0.12), transparent 36%),
      linear-gradient(135deg, rgba(255,255,255,0.86), rgba(246,249,255,0.76));
  }

  .slot-content {
    text-align: center;
    padding: 24px;
  }

  .slot-badge {
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    margin: 0 auto 16px;
    border-radius: 24px;
    color: #fff;
    background:
      radial-gradient(circle at 28% 22%, rgba(255,255,255,0.45), transparent 24%),
      linear-gradient(135deg, var(--cyan), var(--purple));
    font-size: 20px;
    font-weight: 780;
  }

  .slot-content span {
    display: block;
    color: #101827;
    font-weight: 720;
  }

  .slot-content small {
    display: block;
    margin-top: 6px;
    color: #667085;
  }

  .video-showcase {
    padding-top: 96px;
  }

  .video-shell {
    width: min(100%, 1080px);
    margin: 0 auto;
    padding: 10px;
    border: 1.5px dashed rgba(86, 132, 190, 0.3);
    border-radius: 22px;
    background:
      radial-gradient(circle at 50% 4%, rgba(33, 214, 255, 0.14), transparent 34%),
      linear-gradient(135deg, rgba(255,255,255,0.96), rgba(246,249,255,0.9));
    box-shadow: 0 24px 70px rgba(40, 62, 100, 0.1);
  }

  .video-frame {
    overflow: hidden;
    border-radius: 16px;
    background: #242424;
    aspect-ratio: 16 / 9;
  }

  .video-frame video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: #242424;
  }

  .video-note {
    margin-top: 12px;
    color: #8b98ac;
    font-size: 13px;
    font-weight: 650;
    text-align: center;
  }

  .usecase-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .usecase-card {
    min-height: 340px;
    display: flex;
    flex-direction: column;
    padding: 26px;
    border: 1px solid rgba(20,32,51,0.1);
    border-radius: 26px;
    background: rgba(255,255,255,0.82);
    box-shadow: var(--shadow-light);
    backdrop-filter: blur(14px);
    transition: transform 0.24s ease, border-color 0.24s ease;
  }

  .usecase-card:hover {
    transform: translateY(-5px);
    border-color: rgba(33,214,255,0.32);
  }

  .usecase-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    margin-bottom: 20px;
    border-radius: 17px;
    color: #fff;
    background:
      radial-gradient(circle at 28% 22%, rgba(255,255,255,0.45), transparent 24%),
      linear-gradient(135deg, var(--cyan), var(--purple));
    font-size: 21px;
    font-weight: 760;
  }

  .usecase-card .en {
    margin-bottom: 18px;
    color: #53617a;
    font-size: 13px;
  }

  .usecase-card .desc {
    margin-bottom: 18px;
    color: #43516a;
    font-size: 14px;
    line-height: 1.78;
  }

  .ai-insight {
    margin-top: auto;
    padding: 16px;
    border: 1px solid rgba(20,32,51,0.08);
    border-radius: 18px;
    background: rgba(248,251,255,0.9);
  }

  .ai-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 10px;
    padding: 6px 11px;
    border-radius: 999px;
    color: var(--cyan);
    background: rgba(33,214,255,0.08);
    font-size: 12px;
    font-weight: 680;
  }

  .ai-pill::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 14px currentColor;
  }

  .ai-insight p {
    color: #43516a;
    font-size: 14px;
    line-height: 1.7;
  }

  .metric-number {
    margin-bottom: 14px;
    color: #101827;
    font-size: clamp(34px, 3.5vw, 48px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.045em;
  }



  @media (max-width: 1080px) {
    .grid-3,
    .grid-4,
    .usecase-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .function-row {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 768px) {
    .container {
      width: min(100% - 30px, var(--container));
    }

    .page::before {
      background:
        radial-gradient(circle at 8% 4%, rgba(30, 98, 190, 0.55), transparent 10%),
        linear-gradient(180deg, #071525 0%, #071525 7%, #ffffff 32%, #ffffff 100%);
    }

    .hero {
      min-height: 620px;
      padding: 74px 0;
    }

    .hero h1 {
      font-size: clamp(42px, 12vw, 64px);
    }

    .section {
      padding: 60px 0;
    }

    .grid-3,
    .grid-4,
    .usecase-grid {
      grid-template-columns: 1fr;
    }

    .features-intro .section-kicker {
      justify-content: center;
    }

    .features-intro .section-title,
    .features-intro .section-subtitle {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .function-row {
      margin-bottom: 58px;
    }

    .function-copy h3,
    .function-copy p {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .video-shell {
      padding: 7px;
      border-radius: 18px;
    }

    .video-frame {
      border-radius: 12px;
    }


  }

  /* ── Split Card (Option 03 - Document Coverage) ── */
  .split-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 390px;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.09);
    border-radius: 28px;
    background: rgba(255,255,255,0.88);
    box-shadow: 0 30px 90px rgba(30, 41, 59, 0.12);
  }

  .copy-panel {
    padding: clamp(30px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(255,255,255,0.68);
  }

  .copy-panel .section-kicker {
    justify-content: flex-start;
    font-size: 20px;
    font-weight: 850;
  }

  .copy-panel h2 {
    max-width: 520px;
    margin-bottom: 18px;
    font-size: clamp(32px, 4.3vw, 58px);
    line-height: 1.06;
    letter-spacing: -0.045em;
    font-weight: 760;
    text-align: left;
    margin-left: 0;
  }

  .copy-panel p {
    max-width: 520px;
    color: #667085;
    font-size: 17px;
    line-height: 1.9;
    text-align: left;
    margin-left: 0;
    opacity: 1;
  }

  .visual-panel {
    position: relative;
    min-height: 390px;
    overflow: hidden;
    background:
      radial-gradient(circle at 28% 10%, rgba(34, 211, 238, 0.26), transparent 32%),
      radial-gradient(circle at 85% 12%, rgba(255, 78, 205, 0.22), transparent 34%),
      linear-gradient(135deg, #f8fcff 0%, #f3f6ff 48%, #f8edff 100%);
  }

  .visual-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(15,23,42,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15,23,42,0.035) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: 0.42;
    mask-image: radial-gradient(circle at 52% 48%, black 0%, transparent 72%);
  }

  .floating-doc {
    position: absolute;
    width: 260px;
    padding: 12px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 22px;
    background: rgba(255,255,255,0.76);
    box-shadow: 0 22px 60px rgba(30, 41, 59, 0.13);
    backdrop-filter: blur(14px);
    transition: transform 0.28s ease, box-shadow 0.28s ease;
  }

  .floating-doc:hover {
    box-shadow: 0 30px 80px rgba(30, 41, 59, 0.18);
  }

  .floating-doc.invoice {
    left: 40px;
    top: 52px;
    z-index: 1;
    transform: rotate(-6deg);
    opacity: 0.9;
  }

  .floating-doc.po {
    right: 38px;
    top: 92px;
    z-index: 2;
    transform: rotate(5deg);
  }

  .floating-doc.form {
    left: 50%;
    top: 136px;
    z-index: 3;
    transform: translateX(-50%) rotate(0deg);
  }

  .floating-doc.invoice:hover {
    transform: rotate(-4deg) translateY(-4px);
  }

  .floating-doc.po:hover {
    transform: rotate(3deg) translateY(-4px);
  }

  .floating-doc.form:hover {
    transform: translateX(-50%) rotate(0deg) translateY(-4px);
  }

  .doc-preview {
    height: 150px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 16px;
    background:
      radial-gradient(circle at 50% 20%, rgba(34, 211, 238, 0.13), transparent 36%),
      linear-gradient(135deg, #ffffff, #f5f7fb);
  }

  .doc-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform: scale(1.04);
  }

  .floating-doc strong {
    display: block;
    margin-top: 10px;
    color: #1f2937;
    font-size: 13px;
    line-height: 1.25;
  }

  .floating-doc small {
    display: block;
    margin-top: 2px;
    color: #667085;
    font-size: 11px;
  }

  .shine {
    position: absolute;
    inset: -30%;
    background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,0.36) 48%, transparent 62%);
    transform: translateX(-45%);
    animation: shine 4.8s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes shine {
    0%, 45% {
      transform: translateX(-55%);
      opacity: 0;
    }
    55% {
      opacity: 1;
    }
    75%, 100% {
      transform: translateX(55%);
      opacity: 0;
    }
  }

  @media (max-width: 980px) {
    .split-card {
      grid-template-columns: 1fr;
    }

    .copy-panel {
      text-align: center;
      align-items: center;
    }

    .copy-panel h2,
    .copy-panel p {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    .copy-panel .section-kicker {
      justify-content: center;
    }

    .visual-panel {
      min-height: 440px;
    }

    .floating-doc.invoice {
      left: 12%;
      top: 44px;
    }

    .floating-doc.po {
      right: 10%;
      top: 100px;
    }

    .floating-doc.form {
      top: 172px;
    }
  }

  @media (max-width: 640px) {
    .split-card {
      border-radius: 22px;
    }

    .copy-panel {
      padding: 30px 20px;
    }

    .visual-panel {
      min-height: 500px;
    }

    .floating-doc {
      width: 230px;
    }

    .floating-doc.invoice {
      left: 18px;
      top: 34px;
    }

    .floating-doc.po {
      right: 16px;
      top: 150px;
    }

    .floating-doc.form {
      top: 266px;
    }

    .doc-preview {
      height: 130px;
    }
  }

  /* ── Industry Tabs Section ── */
  .hero-head {
    max-width: 850px;
    margin: 0 auto 58px;
    text-align: center;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    color: #ff5bc8;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .kicker::before,
  .kicker::after {
    content: "\2014";
    margin: 0 6px;
    opacity: 0.72;
  }

  .hero-head h1 {
    max-width: 720px;
    margin: 0 auto;
    color: #121a2f;
    font-size: clamp(32px, 4.3vw, 58px);
    font-weight: 760;
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  .hero-head p {
    max-width: 620px;
    margin: 18px auto 0;
    color: #8a94a6;
    font-size: 17px;
    line-height: 1.8;
  }

  .tabs-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: -1px;
    position: relative;
    z-index: 3;
  }

  .tabs {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    max-width: 100%;
    border: 1px solid #e5eaf2;
    border-bottom: none;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(14px);
  }

  .tab {
    min-width: 150px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 18px;
    border: 0;
    border-right: 1px solid #e5eaf2;
    background: rgba(255, 255, 255, 0.72);
    color: #6b7280;
    cursor: pointer;
    font-size: 13px;
    font-weight: 760;
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .tab:last-child {
    border-right: none;
  }

  .tab:hover,
  .tab.active {
    color: #121a2f;
    background: #ffffff;
  }

  .tab .tab-icon {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    background: linear-gradient(135deg, rgba(79, 140, 255, 0.12), rgba(38, 198, 255, 0.08));
    color: var(--accent);
    font-size: 12px;
  }

  .tab.active .tab-icon {
    color: #ffffff;
    background: linear-gradient(135deg, #4f8cff, #26c6ff);
    box-shadow: 0 8px 18px rgba(79, 140, 255, 0.28);
  }

  .panel {
    display: grid;
    grid-template-columns: 0.44fr 0.56fr;
    min-height: 610px;
    overflow: hidden;
    border: 1px solid #e5eaf2;
    border-radius: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(255,255,255,0.9)), #ffffff;
