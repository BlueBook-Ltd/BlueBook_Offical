---
// WhatsApp AI Agent Service Page
// Bluebook Official Website
import Header from "../../../components/Header.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Footer from "../../../components/Footer.astro";
const lang = "zh-Hant";
const title = "WhatsApp AI Agent | Bluebook";
const currentPath = "/zh/services/whatsapp-ai-agent/";
---

<BaseLayout title={title} lang={lang}>
<style>
  :root {
    --primary: #1769ff;
    --primary-dark: #0f4ed8;
    --primary-light: #eaf2ff;
    --navy: #10213b;
    --text: #1d2b44;
    --muted: #63718a;
    --border: #dfe7f3;
    --bg-soft: #f5f8fc;
    --bg-blue-soft: #f3f7ff;
    --white: #ffffff;
    --shadow: 0 16px 42px rgba(16, 33, 59, 0.08);
    --container: 1120px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", Arial, sans-serif;
    color: var(--text);
    background: #ffffff;
    line-height: 1.7;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(100% - 48px, var(--container));
    margin: 0 auto;
  }

  .section {
    padding: 80px 0;
  }

  .section-soft {
    background: var(--bg-soft);
  }

  .section-blue-soft {
    background: var(--bg-blue-soft);
  }

  .section-white {
    background: #ffffff;
  }

  .section-title {
    margin-bottom: 12px;
    color: var(--navy);
    font-size: clamp(32px, 4.3vw, 58px);
    font-weight: 400;
    line-height: 1.06;
    text-align: center;
    letter-spacing: -0.045em;
  }

  .section-subtitle {
    max-width: 760px;
    margin: 0 auto 52px;
    color: var(--muted);
    font-size: 17px;
    text-align: center;
    line-height: 1.9;
  }

  .reveal-item,
  .reveal-fade {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.75s ease, transform 0.75s ease;
    transition-delay: var(--delay, 0ms);
  }

  .section-animate.is-visible .reveal-item,
  .section-animate.is-visible .reveal-fade {
    opacity: 1;
    transform: translateY(0);
  }



  .hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 96px 24px;
    background:
      radial-gradient(circle at 8% 35%, rgba(23, 105, 255, 0.48), transparent 28%),
      radial-gradient(circle at 84% 18%, rgba(77, 163, 255, 0.28), transparent 34%),
      linear-gradient(135deg, #163456 0%, #0b2038 45%, #061426 100%);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px),
      linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.15;
    pointer-events: none;
  }

  .hero::after {
    content: "";
    position: absolute;
    width: 560px;
    height: 560px;
    left: -220px;
    bottom: -260px;
    background: radial-gradient(circle, rgba(23, 105, 255, 0.42), transparent 65%);
    filter: blur(10px);
    pointer-events: none;
    animation: glowFloat 7s ease-in-out infinite alternate;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100%, 980px);
    margin: 0 auto;
    text-align: center;
  }

  .hero h1 {
    margin-bottom: 26px;
    color: #ffffff;
    font-size: clamp(44px, 6vw, 76px);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.055em;
    white-space: nowrap;
    text-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.85s ease forwards;
  }

  .hero-description {
    max-width: 860px;
    margin: 0 auto 42px;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(16px, 1.45vw, 20px);
    line-height: 1.85;
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.85s ease forwards;
    animation-delay: 0.18s;
  }

  .cta-group {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(18px);
    animation: fadeUp 0.85s ease forwards;
    animation-delay: 0.36s;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 178px;
    height: 56px;
    padding: 0 28px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 700;
    transition: all 0.25s ease;
  }

  .btn-secondary {
    color: #7dbbff;
    border: 1.5px solid rgba(77, 163, 255, 0.75);
    background: rgba(23, 105, 255, 0.05);
  }

  .btn-secondary:hover {
    transform: translateY(-3px);
    background: rgba(23, 105, 255, 0.14);
  }

  .top-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .feature-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #ffffff;
    transition: opacity 0.75s ease, transform 0.75s ease, box-shadow 0.25s ease;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
  }

  .icon-box {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    margin-bottom: 22px;
    border-radius: 10px;
    color: var(--primary);
    background: var(--primary-light);
    font-size: 24px;
    font-weight: 700;
  }

  .feature-card h3 {
    margin-bottom: 12px;
    color: var(--navy);
    font-size: 20px;
    font-weight: 500;
  }

  .feature-card p {
    color: var(--muted);
    font-size: 14px;
  }

  .product-screenshot {
    margin-top: 56px;
    overflow: hidden;
    border-radius: 16px;
    box-shadow:
      0 24px 68px rgba(16, 33, 59, 0.12),
      0 8px 24px rgba(16, 33, 59, 0.06);
  }

  .product-screenshot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .pain-list {
    max-width: 820px;
    margin: 0 auto 48px;
  }

  .pain-item {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
    align-items: start;
    margin-bottom: 28px;
    color: var(--text);
    font-size: 17px;
  }

  .number {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #ffffff;
    background: var(--primary);
    font-size: 14px;
    font-weight: 700;
  }

  .message-card {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(16, 33, 59, 0.06);
  }

  .message-card h3 {
    margin-bottom: 14px;
    color: var(--navy);
    font-size: 20px;
    font-weight: 500;
  }

  .message-card p {
    color: var(--muted);
    font-size: 14px;
  }

  .core-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 70px;
    row-gap: 92px;
  }

  .core-feature-item {
    text-align: center;
  }

  .core-feature-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    margin: 0 auto 20px;
    border-radius: 14px;
    color: #ffffff;
    background: linear-gradient(135deg, #1769ff 0%, #54a0ff 100%);
    box-shadow: 0 14px 26px rgba(23, 105, 255, 0.2);
    font-size: 24px;
    font-weight: 700;
  }

  .core-feature-item h3 {
    max-width: 320px;
    margin: 0 auto 14px;
    color: #202b3d;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.035em;
  }

  .core-feature-item p {
    max-width: 330px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .industry-floating-section {
    position: relative;
    overflow: hidden;
    padding: 104px 0 132px;
    background:
      radial-gradient(circle at 8% 14%, rgba(23,105,255,0.18), transparent 32%),
      radial-gradient(circle at 86% 14%, rgba(255,122,183,0.15), transparent 34%),
      radial-gradient(circle at 52% 95%, rgba(77,163,255,0.17), transparent 36%),
      linear-gradient(135deg, #f8fbff 0%, #eef5ff 46%, #fff4fb 100%);
  }

  .industry-floating-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(23,105,255,0.032) 1px, transparent 1px),
      linear-gradient(rgba(23,105,255,0.022) 1px, transparent 1px);
    background-size: 72px 72px;
    pointer-events: none;
  }

  .industry-floating-section .container {
    position: relative;
    z-index: 2;
  }

  .industry-floating-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 28px;
    row-gap: 54px;
    align-items: start;
  }

  .industry-card {
    position: relative;
    min-height: 390px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 26px;
    border-radius: 30px;
    background: linear-gradient(180deg, rgba(255,255,255,0.82), rgba(255,255,255,0.64));
    box-shadow:
      0 24px 68px rgba(16, 33, 59, 0.085),
      inset 0 1px 0 rgba(255,255,255,0.75);
    backdrop-filter: blur(20px);
    transition: opacity 0.75s ease, transform 0.75s ease, box-shadow 0.25s ease;
  }

  .industry-card:hover {
    transform: translateY(var(--offset, 0px)) scale(1.015);
    box-shadow:
      0 34px 88px rgba(16, 33, 59, 0.14),
      inset 0 1px 0 rgba(255,255,255,0.78);
  }

  .industry-card::after {
    content: "";
    position: absolute;
    width: 170px;
    height: 170px;
    right: -78px;
    top: -78px;
    border-radius: 50%;
    background: var(--accent, rgba(23, 105, 255, 0.12));
    pointer-events: none;
  }

  .industry-card.offset-up { --offset: -30px; }
  .industry-card.offset-mid { --offset: 18px; }
  .industry-card.offset-low { --offset: 46px; }
  .industry-card.offset-soft { --offset: -6px; }
  .industry-card.offset-deep { --offset: 38px; }

  .section-animate.is-visible .industry-card.offset-up { transform: translateY(-30px); }
  .section-animate.is-visible .industry-card.offset-mid { transform: translateY(18px); }
  .section-animate.is-visible .industry-card.offset-low { transform: translateY(46px); }
  .section-animate.is-visible .industry-card.offset-soft { transform: translateY(-6px); }
  .section-animate.is-visible .industry-card.offset-deep { transform: translateY(38px); }

  .industry-card .icon {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    margin-bottom: 20px;
    border-radius: 17px;
    color: var(--icon, #1769ff);
    background: var(--icon-bg, rgba(23,105,255,0.1));
    font-size: 22px;
    font-weight: 800;
  }

  .industry-card h3 {
    margin-bottom: 6px;
    color: var(--navy);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.35;
  }

  .industry-card .en {
    margin-bottom: 16px;
    color: #7f8da3;
    font-size: 13px;
  }

  .industry-card .desc {
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .ai-insight {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding: 17px 18px;
    border-radius: 20px;
    background: rgba(255,255,255,0.56);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.72),
      0 10px 28px rgba(23,105,255,0.055);
  }

  .ai-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 9px;
    padding: 5px 10px;
    border-radius: 999px;
    color: var(--icon, #1769ff);
    background: rgba(255,255,255,0.72);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  .ai-pill::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
  }

  .ai-insight p {
    color: var(--text);
    font-size: 14px;
    line-height: 1.65;
  }

  .orange { --icon: #ff7a1a; --icon-bg: #fff0e5; --accent: rgba(255,122,26,0.13); }
  .blue { --icon: #1769ff; --icon-bg: #eaf2ff; --accent: rgba(23,105,255,0.13); }
  .purple { --icon: #8d4dff; --icon-bg: #f1e8ff; --accent: rgba(141,77,255,0.13); }
  .green { --icon: #26b36a; --icon-bg: #e8fbf0; --accent: rgba(38,179,106,0.13); }
  .gray { --icon: #52647a; --icon-bg: #eef3f8; --accent: rgba(82,100,122,0.13); }
  .pink { --icon: #ec4c9a; --icon-bg: #ffe9f4; --accent: rgba(236,76,154,0.13); }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .step-card {
    text-align: center;
  }

  .step-number {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    margin: 0 auto 24px;
    border-radius: 50%;
    color: #ffffff;
    background: var(--primary);
    font-size: 22px;
    font-weight: 700;
    box-shadow: 0 16px 36px rgba(23, 105, 255, 0.26);
  }

  .step-card h3 {
    margin-bottom: 4px;
    color: var(--navy);
    font-size: 20px;
    font-weight: 500;
  }

  .step-card .en {
    margin-bottom: 18px;
    color: #8795aa;
    font-size: 14px;
  }

  .step-image {
    height: 150px;
    display: grid;
    place-items: center;
    margin-bottom: 18px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .step-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .step-card p {
    color: var(--muted);
    font-size: 15px;
  }

  .image-placeholder {
    min-height: 260px;
    display: grid;
    place-items: center;
    margin-top: 56px;
    border: 1.5px dashed #c8d7eb;
    border-radius: 16px;
    color: #9aa9bd;
    background: linear-gradient(180deg, #ffffff 0%, #f5f9ff 100%);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .metric-card {
    padding: 28px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #ffffff;
    text-align: center;
  }

  .metric-number {
    margin-bottom: 6px;
    color: var(--primary);
    font-size: clamp(32px, 4.3vw, 58px);
    font-weight: 300;
    line-height: 1;
  }

  .metric-card h3 {
    margin-bottom: 8px;
    color: var(--navy);
    font-size: 20px;
    font-weight: 600;
  }

  .metric-card p {
    color: var(--muted);
    font-size: 14px;
  }

  /* Draggable testimonial section */

  .testimonial-section {
    overflow: hidden;
  }

  .testimonial-scroll-wrap {
    position: relative;
    width: 100%;
  }

  .testimonial-scroll {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 4px;
    padding: 4px 4px 14px;
    cursor: grab;
    user-select: none;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .testimonial-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .testimonial-scroll.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .testimonial-scroll.is-dragging .testimonial-card {
    pointer-events: none;
  }

  .testimonial-card {
    flex: 0 0 min(420px, 82vw);
    min-height: 176px;
    padding: 26px 28px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(16, 33, 59, 0.025);
    scroll-snap-align: start;
    transition:
      opacity 0.75s ease,
      transform 0.75s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-5px);
    border-color: #c9d8ee;
    box-shadow: var(--shadow);
  }

  .testimonial-scroll.is-dragging .testimonial-card:hover {
    transform: none;
    box-shadow: 0 6px 18px rgba(16, 33, 59, 0.025);
  }

  .testimonial-card h3 {
    margin-bottom: 2px;
    color: #071d3a;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
  }

  .testimonial-card .industry {
    margin-bottom: 18px;
    color: #7b8ba2;
    font-size: 13px;
  }

  .testimonial-card p {
    color: #66758d;
    font-size: 15px;
    line-height: 1.85;
  }

  .edge-fade-left,
  .edge-fade-right {
    pointer-events: none;
    position: absolute;
    top: 0;
    z-index: 2;
    width: 72px;
    height: 100%;
  }

  .edge-fade-left {
    left: 0;
    background: linear-gradient(90deg, #ffffff 0%, rgba(255,255,255,0) 100%);
  }

  .edge-fade-right {
    right: 0;
    background: linear-gradient(90deg, rgba(255,255,255,0) 0%, #ffffff 100%);
  }

  .security-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .security-card {
    padding: 32px;
    border-radius: 8px;
    color: #ffffff;
    background: #18263d;
  }

  .security-card .icon-box {
    color: #ffffff;
    background: rgba(255,255,255,0.12);
  }

  .security-card h3 {
    margin-bottom: 14px;
    font-size: 20px;
    font-weight: 600;
  }

  .security-card p {
    color: rgba(255,255,255,0.78);
    font-size: 14px;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes glowFloat {
    from {
      transform: translate(0, 0) scale(1);
      opacity: 0.75;
    }

    to {
      transform: translate(40px, -24px) scale(1.08);
      opacity: 1;
    }
  }

  @media (min-width: 901px) {
    .testimonial-scroll {
      padding-left: calc((100% - min(100%, 900px)) / 2);
      padding-right: calc((100% - min(100%, 900px)) / 2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  @media (max-width: 1080px) {
    .industry-floating-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 34px;
    }

    .industry-card,
    .industry-card.offset-up,
    .industry-card.offset-mid,
    .industry-card.offset-low,
    .industry-card.offset-soft,
    .industry-card.offset-deep,
    .section-animate.is-visible .industry-card.offset-up,
    .section-animate.is-visible .industry-card.offset-mid,
    .section-animate.is-visible .industry-card.offset-low,
    .section-animate.is-visible .industry-card.offset-soft,
    .section-animate.is-visible .industry-card.offset-deep {
      transform: none;
    }

    .industry-card {
      min-height: 360px;
    }

    .industry-card:hover {
      transform: translateY(-6px);
    }
  }

  @media (max-width: 1024px) {
    .top-features,
    .security-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .core-feature-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 44px;
      row-gap: 72px;
    }

    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .container {
      width: min(100% - 36px, var(--container));
    }

    .section {
      padding: 60px 0;
    }

    .hero {
      min-height: 640px;
      padding: 88px 22px;
    }

    .hero h1 {
      font-size: clamp(42px, 12vw, 64px);
      white-space: normal;
    }

    .hero-description {
      line-height: 1.75;
    }

    .btn {
      width: 100%;
      max-width: 300px;
    }

    .top-features,
    .core-feature-grid,
    .steps,
    .security-grid {
      grid-template-columns: 1fr;
    }

    .core-feature-grid {
      row-gap: 56px;
    }

    .pain-item {
      grid-template-columns: 40px 1fr;
      font-size: 16px;
    }

    .industry-floating-section {
      padding: 78px 0;
    }

    .industry-floating-grid {
      grid-template-columns: 1fr;
      row-gap: 22px;
    }

    .industry-card {
      min-height: auto;
      border-radius: 24px;
    }

    .industry-card:hover {
