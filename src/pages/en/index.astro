---
// Bluebook Homepage — EN
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en';
const currentPath = '/en/';
const title = 'Bluebook — AI Automation · Workflow Design · System Integration';
---

<BaseLayout title={title} lang={lang}>
  <Header lang="en" heroPage={true} currentPath={currentPath} />

  <style>
    /* ── Page-specific CSS (Hero, What We Do, Bento, Process, CTA) ── */

    /* Hero */
    .hero {
      min-height: 50vh;
      display: grid;
      place-items: center;
      padding: 120px 0 96px;
      background: linear-gradient(150deg, #070e1f 0%, #0b1630 60%, #070e1f 100%);
      color: #fff;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 1000px;
      height: 700px;
      background: radial-gradient(ellipse at 50% 30%, rgba(37,99,235,0.18), transparent 65%);
      pointer-events: none;
    }
    .hero-grid-lines {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .hero-grid-lines .line {
      position: absolute;
      top: 0;
      width: 1px;
      height: 100%;
      background: rgba(255,255,255,0.02);
    }
    .hero-grid-lines .line:nth-child(1) { left: 33%; }
    .hero-grid-lines .line:nth-child(2) { right: 33%; }
    .hero-inner {
      width: min(100% - 48px, var(--container));
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* Typography — EN: titleLines block-level, exact two lines */
    .hero h1 {
      max-width: 720px;
      font-size: clamp(40px, 4.6vw, 64px);
      font-weight: 700;
      line-height: 1.06;
      letter-spacing: -0.045em;
      margin-bottom: 24px;
      word-break: normal;
      overflow-wrap: normal;
    }
    .hero-title-line {
      display: block;
    }
    .hero p {
      max-width: 660px;
      font-size: clamp(16px, 1.45vw, 20px);
      color: #94a3b8;
      line-height: 1.8;
      margin-bottom: 40px;
      word-break: normal;
      overflow-wrap: break-word;
    }
    .hero-content {
      max-width: 720px;
      margin: 0 auto;
    }
    .hero .cta-group { justify-content: flex-start; }

    /* What We Do */
    .what-we-do {
      border-top: 1px solid #f1f5f9;
      background: #fff;
    }
    .what-we-do .section-header { max-width: 800px; }

    /* Services Bento */
    .services-section {
      border-top: 1px solid #f1f5f9;
      background: #f0f5ff;
    }
    .services-section .section-header { margin-bottom: 48px; }
    .services-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .service-card {
      background: #fff;
      border: 1px solid #f1f5f9;
      border-radius: 16px;
      padding: 28px;
      position: relative;
      overflow: hidden;
      transition: all 0.2s ease;
      min-height: 220px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .service-card:hover {
      border-color: #bfdbfe;
      box-shadow: 0 12px 40px rgba(37,99,235,0.06);
      transform: translateY(-2px);
    }
    .service-card.glow::before {
      content: "";
      position: absolute;
      top: -40px;
      right: -40px;
      width: 144px;
      height: 144px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(37,99,235,0.07), transparent 70%);
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }
    .service-card:hover.glow::before { opacity: 1; }
    .service-card h3 {
      font-size: 20px;
      font-weight: 560;
      color: var(--ink);
      margin-bottom: 12px;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .service-card p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.7;
    }
    .service-card-link {
      position: absolute;
      inset: 0;
      border-radius: 16px;
    }

    /* How We Work */
    .process-section {
      border-top: 1px solid #f1f5f9;
      background: #fff;
    }
    .process-section .section-header { margin-bottom: 48px; }
    .step-list { display: flex; flex-direction: column; gap: 4px; }
    .step-item {
      display: flex;
      gap: 32px;
      padding: 32px;
      border-radius: 16px;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }
    .step-item:hover {
      border-color: #f1f5f9;
      background: #f8fafc;
    }
    .step-num {
      flex-shrink: 0;
      font-family: 'DM Mono', monospace;
      font-size: 48px;
      font-weight: 700;
      color: #f1f5f9;
      line-height: 1;
      padding-top: 4px;
      user-select: none;
      transition: color 0.2s ease;
    }
    .step-item:hover .step-num { color: #dbeafe; }
    .step-item h3 {
      font-size: 20px;
      font-weight: 560;
      color: var(--ink);
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }
    .step-item p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.7;
    }

    @media (min-width: 768px) {
      .services-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .services-grid { grid-template-columns: repeat(3, 1fr); }
      .hero { min-height: 50vh; padding: 140px 0 120px; }
    }
    @media (max-width: 768px) {
      .section { padding: 60px 0; }
      .hero { padding: 96px 0 72px; }
      .hero h1 {
        max-width: 100%;
        font-size: clamp(34px, 9vw, 46px);
        line-height: 1.12;
      }
      .section-title, section h2 {
        max-width: 100%;
        font-size: clamp(28px, 7vw, 38px);
        line-height: 1.18;
      }
      .services-section { padding: 60px 0; }
      .process-section { padding: 60px 0; }
      .service-card h3 { font-size: 20px; }
    }
  </style>

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-grid-lines" aria-hidden="true">
      <div class="line"></div>
      <div class="line"></div>
    </div>
    <div class="hero-inner">
      <h1>
          <span class="hero-title-line">AI automation for</span>
          <span class="hero-title-line">real business workflows</span>
        </h1>
      <p>Bluebook helps companies analyze existing workflows, identify repetitive, time-consuming, and error-prone tasks, and design practical AI, automation, and system integration solutions that make daily operations more efficient, traceable, and scalable.</p>
      <div class="cta-group">
        <a href="/en/services/" class="btn btn-primary">Explore Services</a>
        <a href="/en/contact/" class="btn btn-primary">Start a Conversation</a>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT WE DO ═══ -->
  <section class="section what-we-do">
    <div class="container">
      <div class="section-header">
        <div class="section-kicker">What We Do</div>
        <h2 class="section-title">Bridging AI tools with day-to-day operations</h2>
        <p class="section-subtitle">We don't just introduce AI tools — we start from real business workflows, identify which steps can be automated, which data needs structuring, and which systems need integration, turning AI into real operational capability your team can actually use.</p>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES BENTO ═══ -->
  <section id="services" class="section services-section">
    <div class="container">
      <div class="section-header">
        <div class="section-kicker">Services</div>
        <h2 class="section-title">From process analysis to system implementation</h2>
        <p class="section-subtitle">From AI consulting and workflow automation design to OCR document processing, system integration, and internal tool development — Bluebook helps companies build smarter, more traceable operations step by step.</p>
      </div>

      <div class="services-grid">
        <article class="service-card glow">
          <h3>WhatsApp AI Agent</h3>
          <p>Organize daily conversations, voice messages, images, and documents from WhatsApp groups into searchable, traceable, and exportable project records.</p>
          <a href="/en/services/whatsapp-ai-agent/" class="service-card-link" aria-label="Explore WhatsApp AI Agent"></a>
        </article>
        <article class="service-card glow">
          <h3>AI OCR & Data Extraction</h3>
          <p>Extract specified fields from PDFs, scanned documents, images, and business files — transforming them into searchable, verifiable, and exportable structured data.</p>
          <a href="/en/services/ai-ocr/" class="service-card-link" aria-label="Explore AI OCR & Data Extraction"></a>
        </article>
        <article class="service-card glow">
          <h3>AI Workflow Automation</h3>
          <p>Convert repetitive, time-consuming, manual-dependent processes into automated workflows — data entry, approvals, notifications, and report generation.</p>
        </article>
        <article class="service-card glow">
          <h3>AI & IT Consulting</h3>
          <p>Help companies assess existing systems, processes, and technical needs — developing AI adoption and digital transformation strategies suited to your business stage.</p>
        </article>
        <article class="service-card glow">
          <h3>System Integration</h3>
          <p>Connect AI, automation tools, and internal systems — including CRM, ERP, Google Workspace, Microsoft 365, APIs, and databases.</p>
        </article>
        <article class="service-card glow">
          <h3>Data Processing & Reporting</h3>
          <p>Automatically organize data from documents, spreadsheets, systems, and APIs — generating data usable for operational analysis, management reporting, and decision support.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ HOW WE WORK ═══ -->
  <section id="process" class="section process-section">
    <div class="container">
      <div class="section-header">
        <div class="section-kicker">How We Work</div>
        <h2 class="section-title">Start with the workflow, not the tool</h2>
      </div>
      <div class="step-list">
        <div class="step-item">
          <span class="step-num">01</span>
          <div>
            <h3>Understand the workflow</h3>
            <p>Understand existing workflows, data sources, system constraints, and daily pain points.</p>
          </div>
        </div>
        <div class="step-item">
          <span class="step-num">02</span>
          <div>
            <h3>Design the automation</h3>
            <p>Design suitable AI, automation, integration, or internal tool solutions — starting with high-value scenarios.</p>
          </div>
        </div>
        <div class="step-item">
          <span class="step-num">03</span>
          <div>
            <h3>Implement and improve</h3>
            <p>Help teams actually use it, collect feedback, and continuously optimize the process and system based on real-world usage.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang="en" />
</BaseLayout>