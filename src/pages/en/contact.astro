---
// Contact Us — English
export const prerender = true;
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
const lang = "en";
const title = "Contact Us | Bluebook";
const currentPath = "/en/contact/";
---

<BaseLayout title={title} lang={lang}>
<style>
  :root {
    --blue: #1769ff;
    --blue-dark: #0f4ed8;
    --blue-light: #eaf2ff;
    --navy: #10213b;
    --ink: #1d2b44;
    --muted: #63718a;
    --border: #dfe7f3;
    --bg-soft: #f5f8fc;
    --white: #ffffff;
    --shadow: 0 16px 42px rgba(16, 33, 59, 0.08);
    --red: #ef4444;
    --green: #16a34a;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", Arial, sans-serif;
    color: var(--ink);
    background: var(--white);
    line-height: 1.7;
  }
  a { color: inherit; text-decoration: none; }
  .container { width: min(100% - 48px, 1160px); margin: 0 auto; }
  .nowrap { white-space: nowrap; }

  /* ── Hero ── */
  .contact-hero {
    position: relative;
    padding: 120px 24px 80px;
    background: linear-gradient(160deg, #0b1d3a 0%, #061426 55%, #030d1a 100%);
    text-align: center;
    overflow: hidden;
  }
  .contact-hero::before {
    content: "";
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 42px 42px;
    pointer-events: none;
  }
  .contact-hero h1 {
    position: relative; z-index: 1;
    max-width: 1000px; margin: 0 auto 18px;
    color: #fff;
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: 700; line-height: 1.06;
    letter-spacing: -0.045em;
  }
  .contact-hero p {
    position: relative; z-index: 1;
    max-width: 560px; margin: 0 auto 0;
    color: rgba(255,255,255,0.78);
    font-size: 17px; line-height: 1.75;
  }

  /* ── Hero Trust Points ── */
  .hero-trust {
    position: relative; z-index: 1;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 12px;
    max-width: 750px; margin: 28px auto 0;
  }
  .hero-trust-item {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 16px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.82);
    font-size: 13px; font-weight: 500;
    white-space: nowrap;
  }
  .hero-trust-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #60a5fa;
    flex-shrink: 0;
  }

  .hero-email-row {
    position: relative; z-index: 1;
    margin-top: 24px;
  }
  .contact-hero .contact-hero-email {
    display: inline-block;
    font-family: 'DM Mono', monospace;
    font-size: 14px; color: #60a5fa;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(96,165,250,0.3);
    transition: border-color 0.2s ease;
  }
  .contact-hero .contact-hero-email:hover { border-color: #60a5fa; }

  /* ── Form Section ── */
  .form-section {
    padding: 80px 0;
    background: var(--white);
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 64px;
    align-items: start;
  }

  /* ── Left Intro ── */
  .form-intro { padding-top: 8px; }
  .form-intro h2 {
    color: var(--navy);
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 600; line-height: 1.16;
    letter-spacing: -0.035em;
    margin-bottom: 12px;
  }
  .form-intro > p {
    color: var(--muted); font-size: 15px; line-height: 1.75;
    margin-bottom: 32px;
  }

  .ask-about-list {
    display: flex; flex-direction: column; gap: 18px;
  }
  .ask-about-item {
    display: flex; align-items: flex-start; gap: 12px;
  }
  .ask-about-item .ask-icon {
    flex-shrink: 0;
    width: 36px; height: 36px; display: grid; place-items: center;
    border-radius: 10px; background: var(--blue-light);
    color: var(--blue); font-size: 13px; font-weight: 700;
    font-family: 'DM Mono', monospace;
  }
  .ask-about-item .ask-text {
    font-size: 14px; color: var(--ink); line-height: 1.6;
    padding-top: 5px;
  }
  .ask-about-item .ask-text strong {
    display: block; font-size: 14px; font-weight: 600; color: var(--navy);
    margin-bottom: 3px;
  }

  /* ── Form Card ── */
  .contact-form {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 40px 36px;
    box-shadow: 0 12px 36px rgba(16, 33, 59, 0.06);
  }
  .contact-form .form-heading {
    font-size: 18px; font-weight: 700; color: var(--navy);
    margin-bottom: 24px;
  }
  .form-group { margin-bottom: 20px; }
  .form-group label {
    display: block;
    font-size: 13px; font-weight: 600; color: var(--navy);
    margin-bottom: 6px;
  }
  .form-group label .optional {
    font-weight: 400; color: var(--muted); font-size: 12px;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-size: 14px; color: var(--ink);
    background: var(--white);
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(23,105,255,0.08);
  }
  .form-group input.error,
  .form-group select.error,
  .form-group textarea.error {
    border-color: var(--red);
  }
  .form-group textarea { min-height: 120px; resize: vertical; }
  .form-group select { cursor: pointer; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5l5 5 5-5' stroke='%2363718a' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 14px center; padding-right: 40px; }

  .form-checkbox {
    display: flex; align-items: flex-start; gap: 10px;
    margin-top: 4px;
  }
  .form-checkbox input[type="checkbox"] {
    width: 18px; height: 18px; margin-top: 2px;
    flex-shrink: 0; accent-color: var(--blue); cursor: pointer;
  }
  .form-checkbox label {
    font-size: 13px; color: var(--muted); line-height: 1.55;
    cursor: pointer;
  }

  .form-error {
    color: var(--red); font-size: 13px;
    margin-top: 4px; display: none;
  }

  .btn-submit {
    display: inline-flex; align-items: center; justify-content: center;
    width: 100%; height: 52px;
    border-radius: 999px; border: none;
    background: var(--blue); color: #fff;
    font-size: 16px; font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    margin-top: 12px;
    box-shadow: 0 4px 16px rgba(23,105,255,0.25);
  }
  .btn-submit:hover { background: var(--blue-dark); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(23,105,255,0.35); }
  .btn-submit:disabled { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }

  .form-success {
    display: none;
    text-align: center; padding: 48px 20px;
  }
  .form-success .check-icon {
    width: 56px; height: 56px; margin: 0 auto 20px;
    border-radius: 50%; background: #dcfce7;
    display: grid; place-items: center;
    color: var(--green); font-size: 28px;
  }
  .form-success h3 {
    color: var(--navy); font-size: 22px; font-weight: 600; margin-bottom: 10px;
  }
  .form-success p {
    color: var(--muted); font-size: 14px; line-height: 1.6;
  }

  /* ── Next Steps Section ── */
  .next-steps {
    padding: 80px 0;
    background: #f8fafc;
  }
  .next-steps-header {
    text-align: center; margin-bottom: 48px;
  }
  .next-steps-kicker {
    font-family: 'DM Mono', monospace;
    font-size: 12px; font-weight: 600;
    color: var(--blue); letter-spacing: 0.2em;
    text-transform: uppercase; margin-bottom: 12px;
  }
  .next-steps-header h2 {
    color: var(--navy);
    font-size: clamp(28px, 3.4vw, 42px);
    font-weight: 600; line-height: 1.12;
    letter-spacing: -0.035em;
    max-width: 640px; margin: 0 auto 14px;
  }
  .next-steps-header p {
    color: var(--muted); font-size: 15px; line-height: 1.75;
    max-width: 560px; margin: 0 auto;
  }

  .next-steps-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .next-step-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 32px 28px;
    text-align: center;
    transition: box-shadow 0.25s ease;
  }
  .next-step-card:hover {
    box-shadow: 0 16px 42px rgba(16, 33, 59, 0.08);
  }
  .next-step-card .step-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--blue-light);
    color: var(--blue);
    font-family: 'DM Mono', monospace;
    font-size: 14px; font-weight: 700;
    margin-bottom: 16px;
  }
  .next-step-card h3 {
    font-size: 18px; font-weight: 700; color: var(--navy);
    margin-bottom: 10px;
  }
  .next-step-card p {
    font-size: 14px; color: var(--muted); line-height: 1.65;
  }

  /* ── Direct Contact Strip ── */
  .direct-strip {
    padding: 64px 0;
    background: #0b1830;
    text-align: center;
    color: #fff;
  }
  .direct-strip .strip-kicker {
    font-family: 'DM Mono', monospace;
    font-size: 12px; font-weight: 600;
    color: #60a5fa; letter-spacing: 0.2em;
    text-transform: uppercase; margin-bottom: 14px;
  }
  .direct-strip p {
    font-size: 15px; color: rgba(255,255,255,0.72);
    margin-bottom: 12px; line-height: 1.7;
    max-width: 500px; margin-left: auto; margin-right: auto;
  }
  .direct-strip-email {
    display: inline-block;
    font-family: 'DM Mono', monospace;
    font-size: 18px; font-weight: 600;
    color: #60a5fa;
    border-bottom: 1.5px solid rgba(96,165,250,0.35);
    padding-bottom: 2px;
    transition: border-color 0.2s ease;
  }
  .direct-strip-email:hover { border-color: #60a5fa; }

  /* ── Honeypot ── */
  ._hp { position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; overflow: hidden; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .contact-hero { padding: 100px 24px 56px; }
    .hero-trust-item { font-size: 12px; white-space: normal; }
    .form-section { padding: 60px 0; }
    .form-grid { grid-template-columns: 1fr; gap: 40px; }
    .contact-form { padding: 28px 20px; }
    .next-steps-cards { grid-template-columns: 1fr; }
    .next-steps { padding: 60px 0; }
    .direct-strip { padding: 48px 24px; }
  }
</style>

<Header lang="en" currentPath={currentPath} />

<header class="contact-hero">
  <h1>Start with your workflow</h1>
  <p>You do not need a complete technical plan to begin. Share one repetitive, time-consuming, or error-prone workflow, and we can help assess feasibility and suggest the next step.</p>
  </header>

<main>
  <!-- ── Form Section ── -->
  <section class="form-section">
    <div class="container">
      <div class="form-grid">
        <!-- ── Left: What to ask about ── -->
        <div class="form-intro">
          <h2>What you can ask us about</h2>
          <p>Describe your current workflow, the tools you use, and the manual work you most want to reduce. We assess whether AI, automation, or system integration is a practical fit.</p>
          <div class="ask-about-list">
            <div class="ask-about-item">
              <span class="ask-icon">01</span>
              <span class="ask-text"><strong>Repetitive, time-consuming tasks</strong>For example: data entry, document filing, recurring reports, message archiving, or cross-system data transfer.</span>
            </div>
            <div class="ask-about-item">
              <span class="ask-icon">02</span>
              <span class="ask-text"><strong>Error-prone processes</strong>For example: manual verification, approval tracking, client request logging, or operational data updates.</span>
            </div>
            <div class="ask-about-item">
              <span class="ask-icon">03</span>
              <span class="ask-text"><strong>Scattered data sources</strong>For example: information spread across WhatsApp, email, PDFs, Excel, or different internal systems.</span>
            </div>
            <div class="ask-about-item">
              <span class="ask-icon">04</span>
              <span class="ask-text"><strong>Tools that need connecting</strong>For example: connecting CRM, forms, documents, notifications, or internal systems into a single workflow.</span>
            </div>
          </div>
        </div>

        <!-- ── Right: Form ── -->
        <div>
          <div class="contact-form" id="contactForm">
            <div class="form-heading">Enquiry Form</div>
            <!-- Honeypot -->
            <div class="_hp">
              <label for="_hp">Leave this empty</label>
              <input type="text" id="_hp" name="_hp" autocomplete="off" tabindex="-1">
            </div>

            <div class="form-group">
              <label for="name">Full name *</label>
              <input type="text" id="name" name="name" placeholder="Your name" required>
              <div class="form-error" id="nameError">Please enter your name.</div>
            </div>

            <div class="form-group">
              <label for="email">Work email *</label>
              <input type="email" id="email" name="email" placeholder="name@company.com" required>
              <div class="form-error" id="emailError">Please enter a valid email address.</div>
            </div>

            <div class="form-group">
              <label for="company">Company <span class="optional">(optional)</span></label>
              <input type="text" id="company" name="company" placeholder="Company or team name">
            </div>

            <div class="form-group">
              <label for="phone">Phone <span class="optional">(optional)</span></label>
              <input type="tel" id="phone" name="phone" placeholder="+852 1234 5678">
            </div>

            <div class="form-group">
              <label for="serviceInterest">Service interest <span class="optional">(optional)</span></label>
              <select id="serviceInterest" name="serviceInterest">
                <option value="">— Please select —</option>
                <option value="AI Workflow Automation">AI Workflow Automation</option>
                <option value="WhatsApp AI Agent">WhatsApp AI Agent</option>
                <option value="OCR & Document Processing">OCR & Document Processing</option>
                <option value="System Integration">System Integration</option>
                <option value="Not Sure Yet">Not Sure Yet</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message *</label>
              <textarea id="message" name="message" placeholder="For example: We want to automate document processing, WhatsApp message organization, or internal approval workflows." required></textarea>
              <div class="form-error" id="messageError">Please enter your message.</div>
            </div>

            <div class="form-group">
              <div class="form-checkbox">
                <input type="checkbox" id="consent" name="consent" required>
                <label for="consent">I agree that Bluebook may use the information above to respond to my enquiry.</label>
              </div>
              <div class="form-error" id="consentError">You must agree to proceed.</div>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">Send Enquiry</button>
            <div class="form-error" id="generalError" style="text-align:center;margin-top:12px;"></div>
          </div>

          <!-- ── Success State ── -->
          <div class="form-success" id="formSuccess">
            <div class="check-icon">&#10003;</div>
            <h3>Your enquiry has been sent</h3>
            <p>We will get back to you soon.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What Happens Next ── -->
  <section class="next-steps">
    <div class="container">
      <div class="next-steps-header">
        <p class="next-steps-kicker">Next Step</p>
        <h2>What happens after you submit?</h2>
        <p>We review your workflow and objectives first, then assess whether there is a practical automation entry point.</p>
      </div>
      <div class="next-steps-cards">
        <div class="next-step-card">
          <div class="step-badge">01</div>
          <h3>Understand your current state</h3>
          <p>We review your workflow, existing tools, data sources, and main pain points.</p>
        </div>
        <div class="next-step-card">
          <div class="step-badge">02</div>
          <h3>Assess feasibility</h3>
          <p>We identify which parts can be automated and what data, access, or system integration requirements may be involved.</p>
        </div>
        <div class="next-step-card">
          <div class="step-badge">03</div>
          <h3>Suggest a practical first step</h3>
          <p>We recommend a small workflow to test first, with expected outcomes and implementation approach.</p>
        </div>
      </div>
    </div>
  </section>
</main>

<Footer lang="en" hideCta={true} />

<script>
  // @ts-nocheck
  const form = document.getElementById("contactForm");
  const success = document.getElementById("formSuccess");
  const submitBtn = document.getElementById("submitBtn");
  const generalError = document.getElementById("generalError");

  function clearErrors() {
    document.querySelectorAll(".form-error").forEach(e => { e.style.display = "none"; });
    document.querySelectorAll(".error").forEach(e => { e.classList.remove("error"); });
    generalError.style.display = "none";
  }

  function showError(id) {
    const el = document.getElementById(id);
    if (el) el.style.display = "block";
    const fieldId = id.replace("Error", "");
    const field = document.getElementById(fieldId);
    if (field) field.classList.add("error");
  }

  submitBtn.addEventListener("click", async function() {
    clearErrors();
    let valid = true;

    const name = document.getElementById("name");
    const email = document.getElementById("email");
    const message = document.getElementById("message");
    const consent = document.getElementById("consent");
    const hp = document.getElementById("_hp");

    if (!name || !name.value.trim()) { showError("nameError"); valid = false; }
    if (!email || !email.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) { showError("emailError"); valid = false; }
    if (!message || !message.value.trim()) { showError("messageError"); valid = false; }
    if (!consent || !consent.checked) { showError("consentError"); valid = false; }

    if (!valid) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: name.value.trim(),
          email: email.value.trim(),
          company: document.getElementById("company")?.value?.trim() || "",
          phone: document.getElementById("phone")?.value?.trim() || "",
          serviceInterest: document.getElementById("serviceInterest")?.value || "",
          message: message.value.trim(),
          consent: consent.checked,
          _hp: hp?.value || "",
        }),
      });

      const data = await res.json();

      if (data.success) {
        form.style.display = "none";
        success.style.display = "block";
      } else {
        generalError.textContent = data.error || "Something went wrong. Please try again.";
        generalError.style.display = "block";
      }
    } catch (err) {
      generalError.textContent = "Network error. Please try again or email us directly.";
      generalError.style.display = "block";
    }

    submitBtn.disabled = false;
    submitBtn.textContent = "Send Enquiry";
  });
</script>

</BaseLayout>