---
// About Us — English — Wessa's design
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";

const currentPath = "/en/about/";
---

<BaseLayout title="About Us | Bluebook" description="Bluebook helps companies analyze existing workflows, identify repetitive, time-consuming, and error-prone tasks, and design automation solutions that are implementable, integrable, and continuously optimizable." lang="en" currentPath={currentPath}>
  <Header lang="en" heroPage={true} currentPath={currentPath} />

  <style>
    :root {
      --navy: #061426;
      --navy-2: #071a31;
      --ink: #102033;
      --muted: #65758b;
      --blue: #2563eb;
      --cyan: #22c7ff;
      --white: #ffffff;
      --hero-muted: rgba(232, 241, 255, 0.72);
      --container: 1120px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: #ffffff;
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC", Arial, sans-serif;
      line-height: 1.65;
      overflow-x: hidden;
    }

    a {
      color: inherit;
    }

    .container {
      position: relative;
      z-index: 10;
      width: min(100% - 48px, var(--container));
      margin: 0 auto;
    }

    .eyebrow {
      color: var(--blue);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .section-head {
      max-width: 880px;
      margin: 0 auto;
      text-align: center;
    }

    .section-head.left {
      max-width: 880px;
      margin: 0;
      text-align: left;
    }

    .section-head h2,
    .results-copy h2 {
      margin-top: 16px;
      color: var(--ink);
      font-size: clamp(38px, 5.2vw, 66px);
      line-height: 1.08;
      letter-spacing: 0em;
      font-weight: 780;
      text-wrap: balance;
    }

    .section-head p,
    .section-head .lead,
    .results-copy .lead {
      max-width: 720px;
      margin: 22px auto 0;
      color: var(--muted);
      font-size: 15.5px;
      line-height: 1.92;
    }

    .section-head.left p,
    .section-head.left .lead {
      margin-left: 0;
      max-width: 640px;
    }

    .bg-section {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      padding: 104px 0 112px;
      background:
        radial-gradient(circle at 50% 42%, rgba(37, 99, 235, 0.105), transparent 34%),
        linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
    }

    .bg-section.alt {
      background:
        radial-gradient(circle at 50% 42%, rgba(37, 99, 235, 0.085), transparent 34%),
        linear-gradient(180deg, #eef4ff 0%, #f8fbff 100%);
    }

    .bg-section::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(90deg, rgba(37, 99, 235, 0.055) 1px, transparent 1px),
        linear-gradient(rgba(37, 99, 235, 0.045) 1px, transparent 1px);
      background-size: 64px 64px;
      opacity: 0.62;
      mask-image: radial-gradient(circle at 50% 42%, black 0%, transparent 78%);
      pointer-events: none;
    }

    .bg-section::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 4;
      background:
        radial-gradient(circle at 50% 46%, transparent 0%, rgba(247, 250, 255, 0.36) 68%, rgba(247, 250, 255, 0.86) 100%),
        linear-gradient(180deg, rgba(255,255,255,0.12), rgba(255,255,255,0.3));
      pointer-events: none;
    }

    .bg-layer {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
    }

    .glow {
      position: absolute;
      left: 50%;
      top: 44%;
      width: 390px;
      height: 390px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background:
        radial-gradient(circle, rgba(34,199,255,0.22) 0%, rgba(37,99,235,0.08) 38%, transparent 70%);
      filter: blur(12px);
      animation: glowPulse 5.8s ease-in-out infinite;
    }

    .ring {
      position: absolute;
      left: 50%;
      top: 44%;
      border-radius: 50%;
      border: 1px solid rgba(37,99,235,0.13);
      transform: translate(-50%, -50%);
      animation: ringPulse 5.4s ease-in-out infinite;
    }

    .ring::before {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      border: 1px solid rgba(255,255,255,0.68);
    }

    .r1 { width: 260px; height: 260px; }
    .r2 { width: 440px; height: 440px; animation-delay: 0.8s; opacity: 0.78; }
    .r3 { width: 660px; height: 660px; animation-delay: 1.6s; opacity: 0.58; }
    .r4 { width: 920px; height: 920px; animation-delay: 2.4s; opacity: 0.36; }
    .r5 { width: 1180px; height: 1180px; animation-delay: 3.2s; opacity: 0.22; }

    .dot {
      position: absolute;
      left: 50%;
      top: 44%;
      width: 7px;
      height: 7px;
      margin: -3.5px;
      border-radius: 50%;
      background: rgba(37,99,235,0.82);
      box-shadow: 0 0 22px rgba(37,99,235,0.45);
    }

    .d1 { transform: rotate(28deg) translateX(220px); animation: dotOrbit1 20s linear infinite; }
    .d2 { transform: rotate(164deg) translateX(330px); animation: dotOrbit2 27s linear infinite; opacity: 0.62; }
    .d3 { transform: rotate(280deg) translateX(455px); animation: dotOrbit3 34s linear infinite; opacity: 0.42; }

    .glass-card {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(37, 99, 235, 0.13);
      border-radius: 22px;
      background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.74));
      box-shadow:
        0 24px 70px rgba(15, 23, 42, 0.065),
        inset 0 1px 0 rgba(255,255,255,0.92);
      backdrop-filter: blur(18px);
      transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
    }

    .glass-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 82% 0%, rgba(37, 99, 235, 0.13), transparent 34%),
        linear-gradient(90deg, rgba(37,99,235,0.035) 1px, transparent 1px),
        linear-gradient(rgba(37,99,235,0.03) 1px, transparent 1px);
      background-size: auto, 28px 28px, 28px 28px;
      opacity: 0.82;
      pointer-events: none;
    }

    .glass-card::after {
      content: "";
      position: absolute;
      left: 24px;
      right: 24px;
      bottom: 0;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, transparent, rgba(37,99,235,0.7), transparent);
      opacity: 0;
      transform: translateY(2px);
      transition: opacity 0.24s ease, transform 0.24s ease;
    }

    .glass-card:hover {
      transform: translateY(-6px);
      border-color: rgba(37,99,235,0.24);
      box-shadow:
        0 30px 86px rgba(37,99,235,0.115),
        inset 0 1px 0 rgba(255,255,255,0.95);
    }

    .glass-card:hover::after {
      opacity: 1;
      transform: translateY(0);
    }

    .card-inner {
      position: relative;
      z-index: 2;
    }

    /* Hero */
    .hero {
      position: relative;
      min-height: 720px;
      overflow: hidden;
      isolation: isolate;
      background:
        radial-gradient(circle at 50% 42%, rgba(37,99,235,0.22), transparent 32%),
        linear-gradient(180deg, #061426 0%, #071a31 100%);
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px),
        linear-gradient(rgba(255,255,255,0.032) 1px, transparent 1px);
      background-size: 72px 72px;
      opacity: 0.15;
      mask-image: radial-gradient(circle at 50% 42%, black 0%, transparent 76%);
      pointer-events: none;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 4;
      background:
        radial-gradient(circle at 50% 44%, transparent 0%, rgba(6,20,38,0.8) 74%),
        linear-gradient(180deg, rgba(6,20,38,0.08), rgba(6,20,38,0.42) 72%, rgba(6,20,38,0.72));
      pointer-events: none;
    }

    .hero .ring {
      border-color: rgba(125,187,255,0.18);
    }

    .hero .ring::before {
      border-color: rgba(255,255,255,0.045);
    }

    .hero .dot {
      background: rgba(142,200,255,0.92);
      box-shadow: 0 0 24px rgba(34,199,255,0.75);
    }

    .hero-content {
      position: relative;
      z-index: 10;
      min-height: 720px;
      width: min(100% - 48px, 980px);
      margin: 0 auto;
      display: grid;
      place-items: center;
      text-align: center;
    }

    .hero-copy {
      max-width: 880px;
    }

    .hero .eyebrow {
      margin-bottom: 18px;
      color: #8ec8ff;
    }

    h1 {
      color: #fff;
      font-size: clamp(42px, 5.8vw, 76px);
      line-height: 0.98;
      letter-spacing: 0em;
      font-weight: 820;
    }

    h1 span {
      color: transparent;
      background: linear-gradient(135deg, #fff, #9ed2ff 45%, #65e7ff);
      -webkit-background-clip: text;
      background-clip: text;
    }

    .hero p {
      margin: 24px auto 0;
      max-width: 720px;
      color: var(--hero-muted);
      font-size: 16px;
      line-height: 1.85;
    }

    .actions {
      margin-top: 32px;
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      min-height: 44px;
      padding: 0 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      text-decoration: none;
      font-size: 13px;
      font-weight: 850;
      transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      color: #fff;
      background: linear-gradient(135deg, var(--blue), var(--cyan));
      box-shadow: 0 18px 42px rgba(37,99,235,0.34);
    }

    .btn-secondary {
      color: rgba(232,241,255,0.88);
      border: 1px solid rgba(255,255,255,0.16);
      background: rgba(255,255,255,0.06);
      backdrop-filter: blur(18px);
    }

    /* Why */
    .why-cards {
      margin-top: 52px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .why-card {
      min-height: 206px;
      padding: 30px 28px;
      text-align: center;
    }

    .icon-wrap {
      width: 46px;
      height: 46px;
      margin: 0 auto 24px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      color: var(--blue);
      background:
        radial-gradient(circle at 50% 35%, rgba(34,199,255,0.18), transparent 54%),
        rgba(255,255,255,0.82);
      border: 1px solid rgba(37,99,235,0.16);
      box-shadow: 0 14px 34px rgba(37,99,235,0.12);
    }

    .icon-wrap svg {
      width: 23px;
      height: 23px;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .why-card h3,
    .timeline-card h3 {
      color: var(--ink);
      font-size: 19px;
      line-height: 1.2;
      letter-spacing: -0.035em;
      font-weight: 760;
    }

    .why-card p,
    .timeline-card p {
      margin-top: 13px;
      color: var(--muted);
      font-size: 13.5px;
      line-height: 1.78;
    }

    /* Capability */
    .cap-head {
      max-width: 820px;
    }

    .cap-head p {
      margin-left: 0;
      max-width: 640px;
    }

    .rail {
      margin-top: 52px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .timeline-card {
      min-height: 260px;
      padding: 30px;
    }

    .number {
      display: inline-flex;
      margin-bottom: 54px;
      color: var(--blue);
      font-size: 44px;
      line-height: 1;
      font-weight: 760;
      letter-spacing: -0.06em;
    }

    /* Process checklist */
    .flow-list {
      max-width: 820px;
      margin: 46px auto 0;
      display: grid;
      gap: 14px;
    }

    .flow-item {
      position: relative;
      overflow: hidden;
      padding: 20px 24px;
      display: flex;
      gap: 16px;
      align-items: center;
      border: 1px solid rgba(37,99,235,0.13);
      border-radius: 20px;
      background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.74));
      box-shadow:
        0 18px 52px rgba(15,23,42,0.055),
        inset 0 1px 0 rgba(255,255,255,0.92);
      backdrop-filter: blur(18px);
      transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
    }

    .flow-item:hover {
      transform: translateY(-4px);
      border-color: rgba(37,99,235,0.24);
      box-shadow:
        0 24px 70px rgba(37,99,235,0.105),
        inset 0 1px 0 rgba(255,255,255,0.95);
    }

    .check {
      width: 28px;
      height: 28px;
      flex: 0 0 28px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: var(--blue);
      background: rgba(37,99,235,0.08);
      font-size: 14px;
      font-weight: 900;
    }

    .flow-item strong {
      color: var(--ink);
      font-size: 16px;
      font-weight: 720;
      letter-spacing: -0.02em;
    }

    .quote {
      position: relative;
      max-width: 760px;
      margin: 34px auto 0;
      padding: 24px 28px 24px 30px;
      color: #33445c;
      font-size: 15px;
      line-height: 1.82;
      font-style: italic;
      border-left: 4px solid var(--blue);
    }

    /* Final sections */
    .process-table {
      max-width: 960px;
      margin: 62px auto 0;
      border-top: 1px solid rgba(37,99,235,0.18);
    }

    .process-step {
      display: grid;
      grid-template-columns: 140px 0.7fr 1.45fr;
      gap: 34px;
      align-items: center;
      padding: 34px 0;
      border-bottom: 1px solid rgba(37,99,235,0.14);
      transition: padding-left 0.24s ease;
    }

    .process-step:hover {
      padding-left: 14px;
    }

    .outline-num {
      color: transparent;
      -webkit-text-stroke: 1.15px rgba(37,99,235,0.76);
      text-stroke: 1.15px rgba(37,99,235,0.76);
      font-size: clamp(48px, 6.4vw, 74px);
      line-height: 0.88;
      font-weight: 850;
      letter-spacing: -0.095em;
      text-shadow: 0 0 30px rgba(37,99,235,0.12);
    }

    .process-step h3,
    .impact-item h3 {
      color: var(--ink);
      font-size: 20px;
      line-height: 1.22;
      letter-spacing: -0.04em;
      font-weight: 780;
    }

    .process-step p,
    .impact-item p {
      color: var(--muted);
      font-size: 13.5px;
      line-height: 1.82;
    }

    .results-layout {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 68px;
      align-items: start;
    }

    .results-copy {
      max-width: 560px;
    }

    .results-copy .lead {
      margin-left: 0;
    }

    .impact-list {
      border-top: 1px solid rgba(37,99,235,0.17);
    }

    .impact-item {
      position: relative;
      padding: 28px 0;
      border-bottom: 1px solid rgba(37,99,235,0.14);
      transition: padding-left 0.24s ease;
    }

    .impact-item:hover {
      padding-left: 16px;
    }

    .impact-item::before {
      content: "";
      position: absolute;
      left: 0;
      top: 34px;
      width: 0;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--blue), var(--cyan));
      transition: width 0.24s ease;
    }

    .impact-item:hover::before {
      width: 34px;
    }

    .impact-item h3 {
      transition: padding-left 0.24s ease;
    }

    .impact-item:hover h3 {
      padding-left: 48px;
    }

    .impact-item p {
      margin-top: 12px;
    }

    @keyframes ringPulse {
      0%, 100% {
        transform: translate(-50%, -50%) scale(0.985);
        opacity: 0.34;
      }

      50% {
        transform: translate(-50%, -50%) scale(1.035);
        opacity: 0.92;
      }
    }

    @keyframes glowPulse {
      0%, 100% {
        transform: translate(-50%, -50%) scale(0.92);
        opacity: 0.52;
      }

      50% {
        transform: translate(-50%, -50%) scale(1.08);
        opacity: 0.88;
      }
    }

    @keyframes dotOrbit1 {
      from { transform: rotate(28deg) translateX(220px); }
      to { transform: rotate(388deg) translateX(220px); }
    }

    @keyframes dotOrbit2 {
      from { transform: rotate(164deg) translateX(330px); }
      to { transform: rotate(524deg) translateX(330px); }
    }

    @keyframes dotOrbit3 {
      from { transform: rotate(280deg) translateX(455px); }
      to { transform: rotate(640deg) translateX(455px); }
    }

    @media (max-width: 980px) {
      .bg-section {
        padding: 86px 0 92px;
      }

      .why-cards,
      .rail,
      .process-step,
      .results-layout {
        grid-template-columns: 1fr;
      }

      .why-cards,
      .rail {
        max-width: 560px;
        margin-left: auto;
        margin-right: auto;
      }

      .process-step {
        gap: 14px;
        align-items: start;
      }

      .r4,
      .r5,
      .d3 {
        display: none;
      }
    }

    @media (max-width: 760px) {
      .hero,
      .hero-content {
        min-height: 680px;
      }

      .hero-content {
        width: min(100% - 32px, 980px);
      }

      h1 {
        font-size: clamp(38px, 12vw, 54px);
      }

      .actions {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }
    }

    @media (max-width: 560px) {
      .container {
        width: min(100% - 32px, var(--container));
      }

      .bg-section {
        padding: 72px 0 78px;
      }

      .section-head h2,
      .results-copy h2 {
        font-size: clamp(36px, 11vw, 50px);
      }

      .section-head p,
      .section-head .lead,
      .results-copy .lead {
        font-size: 14.5px;
      }

      .timeline-card,
      .why-card {
        min-height: auto;
        padding: 26px 22px;
      }

      .number {
        margin-bottom: 42px;
        font-size: 38px;
      }

      .flow-item {
        align-items: flex-start;
        padding: 18px;
      }

      .process-table {
        margin-top: 44px;
      }

      .process-step {
        padding: 28px 0;
      }

      .outline-num {
        font-size: 48px;
      }

      .d2 {
        display: none;
      }
    }
  </style>

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="bg-layer" aria-hidden="true">
        <div class="glow"></div>
        <div class="ring r1"></div>
        <div class="ring r2"></div>
        <div class="ring r3"></div>
        <div class="ring r4"></div>
        <div class="ring r5"></div>
        <span class="dot d1"></span>
        <span class="dot d2"></span>
        <span class="dot d3"></span>
      </div>

      <div class="hero-content">
        <div class="hero-copy">
          <h1>Turn Workflows Into<br>AI-Ready Systems</h1>
          <p>
            Bluebook helps companies identify repetitive workflows and design AI automation that is practical, integrated, and built to improve over time.
          </p>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="bg-section" id="why">
      <div class="bg-layer" aria-hidden="true">
        <div class="glow"></div>
        <div class="ring r1"></div>
        <div class="ring r2"></div>
        <div class="ring r3"></div>
        <div class="ring r4"></div>
        <div class="ring r5"></div>
        <span class="dot d1"></span>
        <span class="dot d2"></span>
        <span class="dot d3"></span>
      </div>

      <div class="container">
        <div class="section-head">
          <div class="eyebrow">Why Bluebook</div>
          <h2>Beyond AI Tools</h2>
          <p>
            Bluebook turns business pain points into clear workflows, then implements them with the right mix of AI, automation, and system integration.
          </p>
        </div>

        <div class="why-cards">
          <article class="glass-card why-card">
            <div class="card-inner">
              <div class="icon-wrap">
                <svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="2"></rect><path d="M4 9V6a2 2 0 0 1 2-2h3"></path><path d="M15 4h3a2 2 0 0 1 2 2v3"></path><path d="M20 15v3a2 2 0 0 1-2 2h-3"></path><path d="M9 20H6a2 2 0 0 1-2-2v-3"></path></svg>
              </div>
              <h3>Workflow-first</h3>
              <p>Understand the way you work before deciding which tasks are worth automating — avoid using AI just for the sake of using AI.</p>
            </div>
          </article>

          <article class="glass-card why-card">
            <div class="card-inner">
              <div class="icon-wrap">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle><path d="M12 2v3"></path><path d="M12 19v3"></path><path d="M2 12h3"></path><path d="M19 12h3"></path></svg>
              </div>
              <h3>Practical by design</h3>
              <p>Solutions account for user habits, data sources, permissions, output formats, and real-world operational constraints.</p>
            </div>
          </article>

          <article class="glass-card why-card">
            <div class="card-inner">
              <div class="icon-wrap">
