{
	"compatibility_date": "2026-05-28",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "bluebook-website",
	"main": "./worker/index.ts",
	"workers_dev": true,
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "www.bluebook.blue/*",
			"zone_name": "bluebook.blue"
		}
	],
	// CMS_ORIGIN: the standalone bluebook-cms Worker's URL, behind Cloudflare
	// Access. Local: `.dev.vars`. Production: add it here once deployed, e.g.
	//   "vars": { "CMS_ORIGIN": "https://cms.bluebook.blue" }
	"observability": {
		"enabled": true
	}
}
