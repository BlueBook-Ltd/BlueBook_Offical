{
	"compatibility_date": "2026-05-28",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "bluebook-website",
	"main": "./worker/index.ts",
	"workers_dev": true,
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "www.bluebook.blue/*",
			"zone_name": "bluebook.blue"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "22fd8036495a4c82bed6f4f16dfce5d2"
		}
	],
	"observability": {
		"enabled": true
	}
}
