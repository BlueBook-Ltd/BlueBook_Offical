{
	"compatibility_date": "2026-05-28",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "bluebook-website",
	"main": "./worker/index.ts",
	"workers_dev": true,
	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "www.bluebook.blue/*",
			"zone_name": "bluebook.blue"
		}
	],
	// CMS_ORIGIN: the standalone bluebook-cms Worker (source in `cms/`).
	// Local: `.dev.vars`. Production: change this if you use another hostname.
	// If the CMS is behind Cloudflare Access, also set the optional
	// CMS_ACCESS_CLIENT_ID / CMS_ACCESS_CLIENT_SECRET secrets.
	"vars": {
		"CMS_ORIGIN": "https://cms.bluebook.blue"
	},
	"observability": {
		"enabled": true
	}
}
