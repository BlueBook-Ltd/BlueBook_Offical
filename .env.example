# CMS (posts, media). Editing and auth live in the standalone cms/ Worker.
# This site only reads published posts from it, never writes.
#
# Server-side (sitemap + same-origin /api/posts and /media proxies): CMS_ORIGIN.
# Browser-side — only if you want the browser fetching the CMS directly
# instead of through this Worker's proxy (rebuild/restart Vite after
# changing, and the CMS's ALLOWED_ORIGINS must include this origin):
#   VITE_CMS_ORIGIN
# Local CMS defaults to http://localhost:5175 (cd cms && npm run dev)
CMS_ORIGIN=http://localhost:5175
# VITE_CMS_ORIGIN=http://localhost:5175

# Optional: Cloudflare Access service token for the CMS. Set these only if the
# CMS Access policy does not exempt /api/posts* and /media/*.
# CMS_ACCESS_CLIENT_ID=
# CMS_ACCESS_CLIENT_SECRET=

# Contact form (Resend)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Local: copy this file to .env and .dev.vars
#   cp .env.example .env
#   cp .env.example .dev.vars
