# CMS (posts, media). Editing and auth live entirely on the standalone
# bluebook-cms Worker now, behind Cloudflare Access — this site only reads
# published posts from it, never writes.
#
# Server-side (sitemap + same-origin /api/posts GET proxy): CMS_ORIGIN.
# Browser-side — only if you want the browser fetching the CMS directly
# instead of through this Worker's proxy (rebuild/restart Vite after
# changing, and bluebook-cms's CORS allowlist must include this origin):
#   VITE_CMS_ORIGIN
# Local bluebook-cms defaults to http://localhost:5175 (cd ../cms && npm run dev)
CMS_ORIGIN=http://localhost:5175
# VITE_CMS_ORIGIN=http://localhost:5175

# Contact form (Resend)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# Local: copy this file to .env and .dev.vars
#   cp .env.example .env
#   cp .env.example .dev.vars
